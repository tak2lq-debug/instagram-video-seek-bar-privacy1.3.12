{
  "manifest_version": 3,
  "name": "Instagram Video Seek Bar",
  "version": "1.3.2",
  "description": "Instagram動画のシーク、プレビュー、画像拡大、フレーム保存。重複表示と配置を修正。",
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Seek Bar Settings",
    "default_popup": "popup.html"
  }
}
